# --- Database -------------------------------------------------------------
# The application connects as pgd_app: a NOBYPASSRLS role. This is the single
# most important line in this file (CMP-14).
DATABASE_URL=postgresql://pgd_app:pgd_local_dev@localhost:5433/pgd_dpp
# Migrations, the seed script and the job worker use the elevated owner role,
# deliberately and separately (§7.4).
MIGRATION_DATABASE_URL=postgresql://pgd_owner:pgd_local_dev@localhost:5433/pgd_dpp

# --- App ------------------------------------------------------------------
APP_ROOT_DOMAIN=localhost:3000
APP_PROTOCOL=http
# 32+ random bytes, base64. Used for session id hashing and token signing.
SESSION_SECRET=replace-me-with-openssl-rand-base64-32

# --- Paystack (PAY-02..PAY-06) -------------------------------------------
# Test keys only outside production. The secret key never reaches the browser.
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Set to 1 in local dev to simulate settlement without Paystack reachable.
PAYSTACK_SIMULATE=1

# --- Email (deliverability is a funnel requirement, §8) -------------------
RESEND_API_KEY=
MAIL_FROM="PGD-DPP Platform <no-reply@example.ng>"
# With no API key set, the mailer writes to .mail/ so local flows are testable.

# --- File storage (section 7.6, CMP-13: Cloudflare R2, a private bucket) --
# All four set: documents, uploads and video go to R2. Unset in development:
# files go to .storage/ on this disk. Unset in production: storage refuses to
# run, unless STORAGE_DRIVER=local is set (for a local `npm start` only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# STORAGE_DRIVER=local

# --- Video (LRN-02, section 7: Cloudflare Stream, never self-hosted) ------
# All five set: lesson video goes to Stream and plays as adaptive-bitrate HLS
# through signed URLs. Any missing: progressive MP4 from object storage.
# The key id and pem come from POST /accounts/{id}/stream/keys, pem as given.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_PEM=

# --- Turnstile (AUTH-05) --------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
